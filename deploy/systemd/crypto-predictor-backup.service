[Unit]
Description=Crypto Predictor — nightly backup (pg_dump + SQLite + parquet)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=crypto-predictor
Group=crypto-predictor
WorkingDirectory=/opt/crypto-predictor
EnvironmentFile=/etc/crypto-predictor/secrets.env
ExecStart=/usr/bin/bash /opt/crypto-predictor/deploy/backup.sh
StandardOutput=journal
StandardError=journal
