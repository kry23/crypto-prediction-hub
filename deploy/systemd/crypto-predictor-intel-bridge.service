[Unit]
Description=Crypto Predictor — intel-hub bridge (polls whale_txs + news_feed)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=crypto-predictor
Group=crypto-predictor
WorkingDirectory=/opt/crypto-predictor
EnvironmentFile=/etc/crypto-predictor/secrets.env
ExecStart=/opt/crypto-predictor/venv/bin/python scripts/run_intel_bridge.py
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
